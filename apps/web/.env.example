# API root from the documented backend. The client appends /api when needed.
CMS_API_BASE_URL=http://localhost:5500/api

# Admin access token used by server-side page reads and writes.
CMS_ACCESS_TOKEN=

# Temporary local-only bypass while backend auth is unavailable.
# Must be false or omitted in production. The token must be accepted by the CMS API.
CMS_DEV_AUTH_BYPASS=false
