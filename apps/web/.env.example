# API root. The client appends /api when needed if it is omitted.
CMS_API_BASE_URL=https://2gns9fe744.execute-api.ap-south-1.amazonaws.com/api

# Admin access token used by server-side page reads and writes.
CMS_ACCESS_TOKEN=

# Temporary local-only bypass while backend auth is unavailable.
# Must be false or omitted in production. Without CMS_ACCESS_TOKEN, a fake local token is used.
CMS_DEV_AUTH_BYPASS=false
